UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URL=http://localhost:8000/api/auth/callback
UPSTOX_ENVIRONMENT=sandbox
MOBILE_API_KEY=change-me
# Fully-automated TOTP login (see app/services/upstox_totp_login.py, auto_login_scheduler.py) --
# optional; leave blank to keep using only the manual browser OAuth flow. UPSTOX_TOTP_USERNAME is
# the Upstox account's registered mobile number, UPSTOX_TOTP_SECRET is the TOTP base32 secret from
# the same authenticator-app setup a human would use, UPSTOX_TOTP_PIN is the account's transaction
# PIN -- NOT the account login password, which this flow never uses.
UPSTOX_TOTP_USERNAME=
UPSTOX_TOTP_SECRET=
UPSTOX_TOTP_PIN=
TOKEN_ENCRYPTION_KEY=
TOKEN_STORE_PATH=/data/upstox_token.enc
ACCOUNT_SNAPSHOT_PATH=/data/account_snapshot.json
AUTO_LOGIN_STATE_PATH=/data/auto_login_state.json
NOTIFICATION_DATABASE_PATH=/data/notifications.sqlite3
JOURNAL_DATABASE_PATH=/data/journal.sqlite3
DEVICE_TOKEN_PATH=/data/device_token.json
MAX_LOSS_SETTINGS_PATH=/data/max_loss_settings.json
NOTIFICATION_RETENTION_DAYS=90
FIREBASE_SERVICE_ACCOUNT_PATH=
TRACKED_INSTRUMENTS_PATH=/data/tracked_instruments.json
UPSTOX_INSTRUMENT_MASTER_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
MOBILE_APP_REDIRECT_URL=personalscalper://auth/callback
# Web client (PersonalScalperWeb) support -- see WEB_CLIENT_ROADMAP.md in the Android repo.
# Leave all three blank to keep the web client entirely disabled/unreachable.
WEB_CLIENT_ORIGIN=
WEB_SESSION_SECRET=
WEB_CLIENT_AUTH_REDIRECT_URL=
